%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18aab5c6bb6a5ac4293377f0a5f3a5cf, type: 3}
  m_Name: kepler-16-b
  m_EditorClassIdentifier: KardashevAscent.Presentation::KardashevAscent.Presentation.Game.PlanetDNA
  record:
    id: kepler-16-b
    displayName: Kepler-16 b
    archiveName: Kepler-16 b
    source: NASA Exoplanet Archive, table pscomppars
    retrieved: 2026-11-05
    solar:
      luminosityW: 4.785881367413777e+25
      semiMajorAxisM: 105436579269.36
      eccentricity: 0.0069
      yearLengthHours: 5490.624
      dayLengthHours: 24
      obliquityDeg: 0
      perihelionLongitudeDeg: 0
      opticalDepth: 0.32
      diffuseK: 0.3
      airTemperatureC: -67.24999999999997
      surfacePressureEarth: 1
    star:
      teffK: 4450
      radiusM: 451439730
      massKg: 1.371447759e+30
      spectralType: 
      count: 2
    planet:
      insolationWm2: 342.5637
      radiusM: 53890480.33
      massKg: 6.320558426e+26
      surfaceGravityMs2: 14.5256998138255
      escapeVelocityMs: 39567.58623157212
      bondAlbedo: 0.3
      equilibriumTempK: 205.9
    flags:
      tidallyLocked: 0
      circumbinary: 1
      surface: gaseous
      clouds: none
    look:
      terrainSeed: 361324997
    provenance:
    - field: solar.luminosityW
      origin: nasa
      note: st_lum = log10(L/Lsun)
    - field: star.teffK
      origin: nasa
      note: st_teff
    - field: star.radiusM
      origin: nasa
      note: st_rad
    - field: star.massKg
      origin: nasa
      note: st_mass
    - field: star.ageGyr
      origin: nasa
      note: st_age
    - field: star.count
      origin: nasa
      note: sy_snum
    - field: solar.semiMajorAxisM
      origin: nasa
      note: pl_orbsmax (au)
    - field: solar.eccentricity
      origin: nasa
      note: pl_orbeccen
    - field: solar.yearLengthHours
      origin: nasa
      note: pl_orbper (days)
    - field: flags.tidallyLocked
      origin: assumed
      note: rotation is not measured for exoplanets
    - field: flags.clouds
      origin: assumed
      note: earth = NASA POWER cloud climatology by latitude and month; none = clear sky (cloud cover unknown)
    - field: flags.circumbinary
      origin: nasa
      note: 'cb_flag: planet orbits both stars'
    - field: solar.dayLengthHours
      origin: assumed
      note: solar day, game value
    - field: solar.obliquityDeg
      origin: assumed
      note: axial tilt, game value
    - field: solar.perihelionLongitudeDeg
      origin: assumed
      note: equinox -> periapsis, game value
    - field: solar.opticalDepth
      origin: assumed
      note: broadband tau, game value
    - field: solar.surfacePressureEarth
      origin: assumed
      note: surface pressure in Earth atmospheres, game value
    - field: solar.diffuseK
      origin: assumed
      note: diffuse-light k, game value
    - field: planet.insolationWm2
      origin: nasa
      note: pl_insol (Earth flux) x 1361 W/m^2
    - field: planet.radiusM
      origin: nasa
      note: pl_rade
    - field: planet.massKg
      origin: nasa
      note: pl_bmasse (may be M sin i)
    - field: flags.surface
      origin: derived
      note: 'radius bins: rocky <= 1.6, gaseous >= 2.0 R_earth (Rogers 2015; Fulton 2017)'
    - field: planet.surfaceGravityMs2
      origin: derived
      note: g = GM/R^2
    - field: planet.escapeVelocityMs
      origin: derived
      note: v = sqrt(2GM/R)
    - field: planet.bondAlbedo
      origin: assumed
      note: game value
    - field: planet.equilibriumTempK
      origin: nasa
      note: pl_eqt (albedo assumption varies by paper)
    - field: solar.airTemperatureC
      origin: derived
      note: equilibrium temperature + greenhouse offset 0 K (assumed)
    - field: look.terrainSeed
      origin: assumed
      note: terrain noise seed from the planet id
