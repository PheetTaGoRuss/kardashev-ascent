--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 18aab5c6bb6a5ac4293377f0a5f3a5cf, type: 3}
  m_Name: mars
  m_EditorClassIdentifier: KardashevAscent.Presentation::KardashevAscent.Presentation.Game.PlanetDNA
  record:
    id: mars
    displayName: Mars
    archiveName: 
    source: NASA NSSDC Mars Fact Sheet (updated 2025-05-19)
    retrieved: 
    solar:
      luminosityW: 3.8279999999999994e+26
      semiMajorAxisM: 227956038589.6944
      eccentricity: 0.0935
      yearLengthHours: 16487.52
      dayLengthHours: 24.6597
      obliquityDeg: 25.19
      perihelionLongitudeDeg: 250.87
      opticalDepth: 0.5
      diffuseK: 0.3
      airTemperatureC: -59
      surfacePressureEarth: 0.00628
    star:
      teffK: 5772
      radiusM: 0
      massKg: 0
      spectralType: 
      count: 1
    planet:
      insolationWm2: 586.2189626902373
      radiusM: 3393149.2
      massKg: 6.390254e+23
      surfaceGravityMs2: 3.7044004790761145
      escapeVelocityMs: 5013.897390664618
      bondAlbedo: 0.25
      equilibriumTempK: 209.82747259769224
    flags:
      tidallyLocked: 0
      circumbinary: 0
      surface: rocky
      clouds: none
    look:
      terrainSeed: 1964534311
      water: none
      oceanFraction: 0.33
    chemistry:
      metallicityDex: 0
      ironMassFraction: 0.32
    provenance:
    - field: solar.luminosityW
      origin: assumed
      note: planets.json luminositySun
    - field: star.teffK
      origin: assumed
      note: planets.json
    - field: star.count
      origin: assumed
      note: sy_snum
    - field: solar.semiMajorAxisM
      origin: nasa
      note: NASA NSSDC Mars Fact Sheet (updated 2025-05-19)
    - field: solar.eccentricity
      origin: nasa
      note: NASA NSSDC Mars Fact Sheet (updated 2025-05-19)
    - field: solar.yearLengthHours
      origin: nasa
      note: NASA NSSDC Mars Fact Sheet (updated 2025-05-19)
    - field: flags.tidallyLocked
      origin: assumed
      note: rotation is not measured for exoplanets
    - field: flags.clouds
      origin: assumed
      note: earth = NASA POWER cloud climatology by latitude and month; none = clear sky (cloud cover unknown)
    - field: flags.circumbinary
      origin: assumed
      note: 'cb_flag: planet orbits both stars'
    - field: solar.dayLengthHours
      origin: nasa
      note: NASA NSSDC Mars Fact Sheet (updated 2025-05-19)
    - field: solar.obliquityDeg
      origin: nasa
      note: NASA NSSDC Mars Fact Sheet (updated 2025-05-19)
    - field: solar.perihelionLongitudeDeg
      origin: literature
      note: Mars solar longitude of perihelion Ls = 250.87 deg (Allison & McEwen 2000, NASA GISS Mars24); the fact sheet's 336.04 deg is measured from Earth's equinox
    - field: solar.opticalDepth
      origin: assumed
      note: broadband tau, game value
    - field: solar.surfacePressureEarth
      origin: nasa
      note: NASA NSSDC Mars Fact Sheet (updated 2025-05-19)
    - field: solar.diffuseK
      origin: assumed
      note: diffuse-light k, game value
    - field: planet.insolationWm2
      origin: derived
      note: L / (4 pi a^2)
    - field: planet.radiusM
      origin: nasa
      note: NASA NSSDC Mars Fact Sheet (updated 2025-05-19)
    - field: planet.massKg
      origin: nasa
      note: NASA NSSDC Mars Fact Sheet (updated 2025-05-19)
    - field: flags.surface
      origin: derived
      note: 'radius bins: rocky <= 1.6, gaseous >= 2.0 R_earth (Rogers 2015; Fulton 2017)'
    - field: planet.surfaceGravityMs2
      origin: derived
      note: g = GM/R^2
    - field: planet.escapeVelocityMs
      origin: derived
      note: v = sqrt(2GM/R)
    - field: planet.bondAlbedo
      origin: nasa
      note: NASA NSSDC Mars Fact Sheet (updated 2025-05-19)
    - field: planet.equilibriumTempK
      origin: derived
      note: '[L(1-A)/(16 pi sigma a^2)]^(1/4)'
    - field: solar.airTemperatureC
      origin: nasa
      note: NASA NSSDC Mars Fact Sheet (updated 2025-05-19)
    - field: look.terrainSeed
      origin: assumed
      note: terrain noise seed from the planet id
    - field: look.water
      origin: assumed
      note: surface water is not measurable for exoplanets yet
    - field: look.oceanFraction
      origin: assumed
      note: share of the surface in low basins (seas, or dry basins), game value
    - field: chemistry.metallicityDex
      origin: assumed
      note: 'not in the archive: solar metallicity assumed'
    - field: chemistry.ironMassFraction
      origin: assumed
      note: 'composition not measured: Earth-like 32 wt % iron assumed'
