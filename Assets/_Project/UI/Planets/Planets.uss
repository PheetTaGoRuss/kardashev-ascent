.planets {
    position: absolute;
    top: 80px;
    left: 50%;
    translate: -50% 0;
    width: 640px;
    max-width: 96%;
    max-height: 84%;
    padding: 10px 12px;
}
.planets.panel { background-color: rgba(10, 14, 24, 0.97); }

.title-row { flex-direction: row; align-items: flex-start; }
.title-text { flex-grow: 1; }
.close-button {
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    font-size: 16px;
    color: var(--text-muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.close-button:hover { color: var(--text); }

.planets-body { flex-direction: row; flex-grow: 1; flex-shrink: 1; margin-top: 8px; min-height: 120px; }
.planet-list { width: 190px; flex-shrink: 0; margin-right: 10px; }
.planet-details { flex-grow: 1; flex-shrink: 1; }

.planet-item {
    margin: 0 0 4px 0;
    padding: 6px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(255, 255, 255, 0.04);
    -unity-text-align: middle-left;
    white-space: normal;
    color: var(--text);
}
.planet-item:hover { background-color: rgba(255, 255, 255, 0.09); }
.planet-item.selected { border-color: var(--accent); background-color: rgba(143, 179, 255, 0.14); }
.planet-item.unplayable { color: var(--text-muted); }

.rows { margin-top: 8px; }
.row { flex-direction: row; align-items: center; padding: 2px 4px; border-radius: 3px; }
.row:hover { background-color: rgba(255, 255, 255, 0.05); }
.row-label { width: 120px; flex-shrink: 0; font-size: 11px; color: var(--text-muted); padding: 0; margin: 0; }
.row-value { flex-grow: 1; flex-shrink: 1; font-size: 12px; padding: 0; margin: 0; white-space: normal; }
.row-section { margin-top: 8px; }

.chip {
    font-size: 9px;
    -unity-font-style: bold;
    padding: 1px 4px;
    margin: 0 0 0 6px;
    border-radius: 3px;
    color: rgb(12, 16, 26);
    -unity-text-align: middle-center;
    min-width: 44px;
}
.origin-nasa { background-color: rgb(143, 179, 255); }
.origin-derived { background-color: rgb(196, 160, 255); }
.origin-assumed { background-color: rgb(242, 190, 80); }
.origin-unknown { background-color: rgb(120, 128, 150); }

.verdict { margin-top: 10px; }
.verdict.warn { color: var(--warning); }
.verdict.bad { color: var(--critical); }
.body { font-size: 12px; padding: 0; margin: 0; }
.wrap { white-space: normal; }

.footer { margin-top: 8px; }
.legend { flex-direction: row; flex-wrap: wrap; align-items: center; }
.legend .chip { margin: 0 4px 0 0; }
.legend-text { margin-right: 10px; }
.note { margin-top: 6px; min-height: 28px; }
.land-button {
    margin: 6px 0 0 0;
    height: 28px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(12, 16, 26);
    background-color: var(--accent);
    border-width: 0;
    border-radius: 4px;
}
.land-button:hover { background-color: rgb(170, 198, 255); }
.land-button:disabled { background-color: rgba(255, 255, 255, 0.10); color: var(--text-muted); }
