.sky-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.labels { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.dome-label {
    position: absolute;
    font-size: 14px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
    -unity-text-outline-width: 0.4px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

.sky {
    position: absolute;
    top: 88px;
    right: 8px;
    width: 480px;
    max-height: 88%;
    padding: 10px 12px;
}
.sky.panel { background-color: rgba(9, 13, 24, 0.95); }
.title-row { flex-direction: row; }
.title-text { flex-grow: 1; }
.sky-scroll { flex-grow: 1; flex-shrink: 1; }

.orbit { height: 110px; margin-top: 6px; background-color: rgba(255, 255, 255, 0.03); border-radius: 0; }
.step { margin-top: 10px; }
.body { font-size: 14px; padding: 0; margin: 2px 0 0 0; white-space: normal; }
.formula {
    font-size: 14px;
    padding: 4px 6px;
    margin: 3px 0 0 0;
    white-space: normal;
    background-color: rgba(255, 199, 92, 0.07);
    border-radius: 0;
}
.formula.unknown { color: var(--text-muted); }
.wrap { white-space: normal; }
.action {
    margin: 4px 0 0 0;
    height: 26px;
    font-size: 14px;
    color: var(--on-accent);
    background-color: var(--accent);
    border-width: 0;
    border-radius: 0;
}
.action:hover { background-color: rgb(255, 220, 140); }
.action:disabled { background-color: rgba(255, 255, 255, 0.10); color: var(--text-muted); }
.log { margin-top: 2px; }
.orbit-label { position: absolute; font-size: 14px; color: var(--text-muted); padding: 0; margin: 0; }

/* Bigger, easier-to-read captions in the sky panel (director 2026-11-14). */
.sky .caption { font-size: 14px; }
.sky .heading { font-size: 14px; }
.sky .value { font-size: 18px; }
