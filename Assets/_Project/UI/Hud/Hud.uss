.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    align-items: stretch;
}

.top-bar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: 8px 12px 0 12px;
    padding: 6px 14px;
    min-height: 52px;
}

.block {
    justify-content: center;
    padding: 0 4px;
}

.time-block { min-width: 170px; flex-shrink: 0; }
.power-block { min-width: 150px; flex-shrink: 0; }
.meter-block { min-width: 170px; flex-shrink: 0; }
.build-block { min-width: 300px; flex-shrink: 0; }   /* one row of material icons: the bar keeps its height */
.build-block .caption { white-space: normal; }

.divider {
    width: 1px;
    align-self: stretch;
    margin: 2px 12px;
    background-color: var(--panel-border);
}

.spacer { flex-grow: 1; }

.battery-fill { background-color: var(--good); }
.battery-fill.warning { background-color: var(--warning); }
.battery-fill.critical { background-color: var(--critical); }
.k-fill { background-color: var(--accent); }

.speed-row { flex-direction: row; margin-top: 3px; }

.speed-button {
    margin: 0 0 0 4px;
    padding: 3px 8px;
    font-size: 14px;
    color: var(--text-muted);
    background-color: var(--button);
    border-width: 2px;
    border-color: var(--panel-border);
    border-radius: 0;
}

.speed-button:hover {
    color: var(--text);
    background-color: var(--button-hover);
    border-color: var(--accent);
}

.speed-button.selected {
    color: var(--accent);
    background-color: rgba(255, 199, 92, 0.16);
    border-color: var(--accent);
    -unity-font-style: bold;
}

.alert {
    align-self: center;
    margin-top: 8px;
    padding: 6px 14px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--on-accent);
    background-color: var(--critical);
    border-radius: 0;
}

.toast {
    align-self: center;
    margin-top: 8px;
    padding: 6px 14px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text);
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 0;
}
