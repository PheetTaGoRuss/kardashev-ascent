/* Shared look for every UI Toolkit screen (director 2026-11-14): flat, square, nearly opaque dark-grey panels
   with an amber accent, in the spirit of factory games such as Mindustry (inspired by, not copied).
   The same colours for code-built UI are in Scripts/Presentation/UI/UiPalette.cs. */
:root {
    --panel-bg: rgba(22, 22, 26, 0.97);
    --panel-border: rgb(69, 69, 77);
    --text: rgb(242, 242, 242);
    --text-muted: rgb(166, 166, 171);
    --good: rgb(110, 220, 130);
    --warning: rgb(242, 190, 80);
    --critical: rgb(255, 120, 105);
    --accent: rgb(255, 199, 92);
    --accent-dark: rgb(120, 92, 40);
    --button: rgb(40, 40, 46);
    --button-hover: rgb(54, 54, 61);
    --on-accent: rgb(26, 20, 10);
    --track: rgba(255, 255, 255, 0.10);
    -unity-font-style: normal;
    color: var(--text);
}

/* Panels: square blocks with a grey frame and an amber strip along the top. */
.panel {
    background-color: var(--panel-bg);
    border-color: var(--panel-border);
    border-width: 2px;
    border-top-width: 3px;
    border-top-color: var(--accent);
    border-radius: 0;
}

.heading {
    font-size: 10px;
    color: var(--accent);
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 0;
    margin: 0;
}

.value {
    font-size: 15px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.caption {
    font-size: 11px;
    color: var(--text-muted);
    padding: 0;
    margin: 0;
}

/* Meters: square bars in a dark trough. */
.meter {
    height: 8px;
    border-radius: 0;
    background-color: rgb(12, 12, 14);
    border-width: 1px;
    border-color: var(--panel-border);
    margin: 3px 0;
    overflow: hidden;
}

.meter-fill {
    height: 100%;
    width: 0;
    border-radius: 0;
    background-color: var(--accent);
}

.hidden {
    display: none;
}

/* Every button: a dark grey block with a frame that lights up amber under the mouse. */
.unity-button {
    color: var(--text);
    background-color: var(--button);
    border-color: var(--panel-border);
    border-width: 2px;
    border-radius: 0;
}
.unity-button:hover { background-color: var(--button-hover); border-color: var(--accent); }
.unity-button:active,
.unity-button:hover:active { background-color: var(--accent-dark); color: var(--text); }
.unity-button:focus { background-color: var(--button); }
.unity-button:focus:hover { background-color: var(--button-hover); }
.unity-button:disabled { opacity: 0.4; }
/* The main action on a panel: a solid amber block. */
.primary-button { color: var(--on-accent); background-color: var(--accent); border-color: var(--accent); -unity-font-style: bold; }
.primary-button:hover { background-color: rgb(255, 220, 140); }

/* Tabs: the system tab bar and sub-categories inside a window. Selected = amber frame and text. */
.tab {
    height: 24px;
    margin: 0 3px 0 0;
    padding: 0 8px;
    font-size: 11px;
    color: var(--text);
    background-color: var(--button);
    border-width: 2px;
    border-color: var(--panel-border);
    border-radius: 0;
}
.tab:hover { background-color: var(--button-hover); border-color: var(--accent); }
.tab.selected { color: var(--accent); background-color: rgba(255, 199, 92, 0.16); border-color: var(--accent); -unity-font-style: bold; }
.tab.locked { color: var(--text-muted); background-color: rgba(255, 255, 255, 0.04); }

/* Text boxes (answers, names, the calculator). */
.unity-base-text-field__input {
    background-color: rgb(30, 30, 34);
    color: var(--text);
    border-color: rgb(84, 84, 92);
    border-width: 2px;
    border-radius: 0;
}
.unity-base-text-field:focus .unity-base-text-field__input { border-color: var(--accent); }
.puzzle-field { height: 26px; margin: 0; }
.puzzle-field .unity-base-text-field__input { padding: 0 4px; }

/* Scroll bars: thin square grey. */
.unity-scroller--vertical { width: 10px; }
.unity-scroller .unity-base-slider__tracker { background-color: rgb(16, 16, 18); border-width: 0; border-radius: 0; }
.unity-scroller .unity-base-slider__dragger { background-color: rgb(84, 84, 92); border-width: 0; border-radius: 0; }
.unity-scroller .unity-repeat-button { display: none; }
