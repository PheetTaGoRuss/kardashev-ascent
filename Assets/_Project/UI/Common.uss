/* Shared look for every UI Toolkit screen in Kardashev Ascent: dark panels on space, light text. */
:root {
    --panel-bg: rgba(10, 14, 24, 0.86);
    --panel-border: rgba(150, 170, 210, 0.22);
    --text: rgb(230, 236, 255);
    --text-muted: rgb(150, 162, 190);
    --good: rgb(95, 211, 141);
    --warning: rgb(242, 190, 80);
    --critical: rgb(255, 120, 105);
    --accent: rgb(143, 179, 255);
    --track: rgba(255, 255, 255, 0.10);
    -unity-font-style: normal;
    color: var(--text);
}

.panel {
    background-color: var(--panel-bg);
    border-color: var(--panel-border);
    border-width: 1px;
    border-radius: 6px;
}

.heading {
    font-size: 10px;
    color: var(--text-muted);
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 0;
    margin: 0;
}

.value {
    font-size: 15px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.caption {
    font-size: 11px;
    color: var(--text-muted);
    padding: 0;
    margin: 0;
}

.meter {
    height: 8px;
    border-radius: 4px;
    background-color: var(--track);
    margin: 3px 0;
    overflow: hidden;
}

.meter-fill {
    height: 100%;
    width: 0;
    border-radius: 4px;
    background-color: var(--accent);
}

.hidden {
    display: none;
}

/* Tabs: the system tab bar and sub-categories inside a window. Selected = accent, others quiet. */
.tab {
    height: 22px;
    margin: 0 3px 0 0;
    padding: 0 8px;
    font-size: 11px;
    color: var(--text);
    background-color: rgba(143, 179, 255, 0.12);
    border-width: 0;
    border-radius: 3px;
}
.tab:hover { background-color: rgba(143, 179, 255, 0.28); }
.tab.selected { color: rgb(10, 14, 24); background-color: var(--accent); -unity-font-style: bold; }
.tab.locked { color: var(--text-muted); background-color: rgba(255, 255, 255, 0.05); }

/* Answer boxes in puzzles. */
.puzzle-field { height: 22px; margin: 0; }
.puzzle-field .unity-base-text-field__input {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(230, 235, 245);
    border-color: rgba(143, 179, 255, 0.5);
    border-width: 1px;
    border-radius: 3px;
    padding: 0 4px;
}
