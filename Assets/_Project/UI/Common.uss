/* Shared look for every UI Toolkit screen in Kardashev Ascent: dark panels on space, light text. */
:root {
    --panel-bg: rgba(10, 14, 24, 0.86);
    --panel-border: rgba(150, 170, 210, 0.22);
    --text: rgb(230, 236, 255);
    --text-muted: rgb(150, 162, 190);
    --good: rgb(95, 211, 141);
    --warning: rgb(242, 190, 80);
    --critical: rgb(255, 120, 105);
    --accent: rgb(143, 179, 255);
    --track: rgba(255, 255, 255, 0.10);
    -unity-font-style: normal;
    color: var(--text);
}

.panel {
    background-color: var(--panel-bg);
    border-color: var(--panel-border);
    border-width: 1px;
    border-radius: 6px;
}

.heading {
    font-size: 10px;
    color: var(--text-muted);
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 0;
    margin: 0;
}

.value {
    font-size: 15px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0;
}

.caption {
    font-size: 11px;
    color: var(--text-muted);
    padding: 0;
    margin: 0;
}

.meter {
    height: 8px;
    border-radius: 4px;
    background-color: var(--track);
    margin: 3px 0;
    overflow: hidden;
}

.meter-fill {
    height: 100%;
    width: 0;
    border-radius: 4px;
    background-color: var(--accent);
}

.hidden {
    display: none;
}
