<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Workforce.uss" />
    <ui:VisualElement name="workforce" class="workforce panel hidden">
        <ui:VisualElement class="title-row">
            <ui:VisualElement class="title-text">
                <ui:Label class="value" text="Robots" />
                <ui:Label name="subtitle" class="caption" text="G: close" />
            </ui:VisualElement>
            <ui:Button name="close" class="close-button" text="×" />
        </ui:VisualElement>
        <ui:Label name="summary" class="body" text="" />
        <ui:ScrollView name="scroll" class="workforce-scroll" mode="Vertical">
            <ui:VisualElement name="groups" />
            <ui:VisualElement name="group-actions" class="button-row" />
            <ui:Label class="heading section-head" text="TASKS" />
            <ui:VisualElement name="tasks" />
            <ui:Label class="heading section-head" text="WORKSHOP" />
            <ui:Label name="workshop-status" class="caption wrap" text="" />
            <ui:VisualElement name="workshop" />
            <ui:Label name="workshop-message" class="caption wrap message" text="" />
            <ui:Label name="notes" class="caption wrap notes" text="" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
