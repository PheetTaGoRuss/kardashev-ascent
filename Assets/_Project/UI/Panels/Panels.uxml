<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Panels.uss" />
    <ui:VisualElement name="screen" class="screen" picking-mode="Ignore">

        <ui:VisualElement name="drag-rect" class="drag-rect hidden" picking-mode="Ignore" />

        <ui:VisualElement name="left" class="left-column" picking-mode="Ignore">
            <ui:VisualElement name="hover-box" class="panel box hidden">
                <ui:Label name="hover-text" class="body" text="" />
                <ui:Label name="hover-hint" class="caption" text="Click to build here" />
            </ui:VisualElement>

            <ui:VisualElement name="site-box" class="panel box hidden">
                <ui:Label name="site-title" class="value" text="Building site" />
                <ui:Label name="site-text" class="body" text="" />
                <ui:Label class="caption" text="Drag from the bar below · click a slot · box: many · Ctrl+A: all" />
            </ui:VisualElement>

            <ui:VisualElement name="planner-box" class="panel box hidden">
                <ui:Label name="planner-title" class="value" text="Plan a solar panel" />
                <ui:Label name="battery-text" class="body hidden" text="" />
                <ui:Label name="tilt-label" class="body slider-label" text="Tilt β" />
                <ui:Slider name="tilt" class="slider" low-value="0" high-value="90" />
                <ui:Label name="facing-label" class="body slider-label" text="Facing γ" />
                <ui:Slider name="facing" class="slider" low-value="0" high-value="359" />
                <ui:Label name="planner-numbers" class="body numbers" text="" />
                <ui:Label name="planner-best" class="body" text="" />
                <ui:Label name="planner-reason" class="body warn hidden" text="" />
                <ui:Label name="multi-text" class="body hidden" text="" />
                <ui:Label name="planner-cost" class="body" text="" />
                <ui:VisualElement class="button-row">
                    <ui:Button name="best-button" class="action-button" text="Edit angle" />
                    <ui:Button name="place-button" class="action-button primary" text="Place panel (P)" />
                </ui:VisualElement>
                <ui:VisualElement name="multi-buttons" class="button-row hidden">
                    <ui:Button name="remove-all-button" class="action-button" text="Remove (Del)" />
                    <ui:Button name="reangle-button" class="action-button" text="Set angle" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="placed-box" class="panel box hidden">
                <ui:Label name="placed-title" class="value" text="Solar panel" />
                <ui:Label name="placed-angles" class="body" text="" />
                <ui:Label name="placed-numbers" class="body numbers" text="" />
                <ui:Label name="placed-bonus" class="body bonus hidden" text="★ Best-angle bonus" />
                <ui:VisualElement name="adjust-box" class="hidden">
                    <ui:Label class="heading section-head" text="ADJUST ANGLES" />
                    <ui:Label name="adjust-tilt-label" class="body slider-label" text="Tilt β" />
                    <ui:Slider name="adjust-tilt" class="slider" low-value="0" high-value="90" />
                    <ui:Label name="adjust-facing-label" class="body slider-label" text="Facing γ" />
                    <ui:Slider name="adjust-facing" class="slider" low-value="0" high-value="359" />
                    <ui:Label name="adjust-gain" class="body numbers" text="" />
                    <ui:VisualElement class="button-row">
                        <ui:Button name="adjust-best" class="action-button" text="Edit angle" />
                        <ui:Button name="adjust-apply" class="action-button primary" text="Send a robot to turn it" />
                        <ui:Button name="adjust-cancel" class="action-button hidden" text="Cancel" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="button-row">
                    <ui:Button name="remove-button" class="action-button" text="Remove (Del)" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label name="totals" class="caption totals hidden" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="bottom-left" class="bottom-left" picking-mode="Ignore">
            <ui:Label name="map-hint" class="caption hint" text="M: light-potential map" />
            <ui:Label name="help" class="panel box body help" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="build-info" class="panel box build-info hidden">
            <ui:VisualElement class="build-info-head">
                <ui:Label name="build-info-title" class="value" text="" />
                <ui:Button name="build-info-close" class="info-close" text="×" />
            </ui:VisualElement>
            <ui:Label name="build-info-text" class="body" text="" />
        </ui:VisualElement>

        <ui:VisualElement name="build-bar" class="panel box build-bar hidden">
            <ui:VisualElement class="build-tabs">
                <ui:Button name="cat-power" class="tab" text="Power" />
                <ui:Button name="cat-stations" class="tab" text="Stations" />
                <ui:Button name="cat-industry" class="tab" text="Industry" />
            </ui:VisualElement>
            <ui:VisualElement class="button-row build-row">
                <ui:VisualElement name="item-panel" class="build-item"><ui:Button name="mode-panel" class="action-button mode" text="Solar panel" /><ui:Button name="info-panel" class="info-button" text="i" /></ui:VisualElement>
                <ui:VisualElement name="item-floating" class="build-item"><ui:Button name="mode-floating" class="action-button mode" text="Floating solar" /><ui:Button name="info-floating" class="info-button" text="i" /></ui:VisualElement>
                <ui:VisualElement name="item-tidal" class="build-item"><ui:Button name="mode-tidal" class="action-button mode" text="Tidal turbine" /><ui:Button name="info-tidal" class="info-button" text="i" /></ui:VisualElement>
                <ui:VisualElement name="item-wave" class="build-item"><ui:Button name="mode-wave" class="action-button mode" text="Wave converter" /><ui:Button name="info-wave" class="info-button" text="i" /></ui:VisualElement>
                <ui:VisualElement name="item-battery" class="build-item"><ui:Button name="mode-battery" class="action-button mode" text="Battery yard" /><ui:Button name="info-battery" class="info-button" text="i" /></ui:VisualElement>
                <ui:VisualElement name="item-workshop" class="build-item"><ui:Button name="mode-workshop" class="action-button mode" text="Workshop" /><ui:Button name="info-workshop" class="info-button" text="i" /></ui:VisualElement>
                <ui:VisualElement name="item-station" class="build-item"><ui:Button name="mode-station" class="action-button mode" text="Charger" /><ui:Button name="info-station" class="info-button" text="i" /></ui:VisualElement>
                <ui:VisualElement name="item-relay" class="build-item"><ui:Button name="mode-relay" class="action-button mode" text="Relay" /><ui:Button name="info-relay" class="info-button" text="i" /></ui:VisualElement>
                <ui:VisualElement name="item-research" class="build-item"><ui:Button name="mode-research" class="action-button mode" text="Research Station" /><ui:Button name="info-research" class="info-button" text="i" /></ui:VisualElement>
                <ui:VisualElement name="item-alumina" class="build-item"><ui:Button name="mode-alumina" class="action-button mode" text="Alumina plant" /><ui:Button name="info-alumina" class="info-button" text="i" /></ui:VisualElement>
                <ui:VisualElement name="item-electrolyser" class="build-item"><ui:Button name="mode-electrolyser" class="action-button mode" text="Electrolysis cell" /><ui:Button name="info-electrolyser" class="info-button" text="i" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="build-hint" class="caption" text="Drag a building onto the site · Tab: switch" />
        </ui:VisualElement>

        <ui:VisualElement name="legend" class="panel box legend hidden">
            <ui:Label class="body" text="Solar potential, kWh per m² of panel per year" />
            <ui:VisualElement name="legend-bar" class="legend-bar" />
            <ui:VisualElement class="legend-range">
                <ui:Label name="legend-min" class="caption" text="" />
                <ui:Label name="legend-max" class="caption" text="" />
            </ui:VisualElement>
            <ui:Label name="legend-tile" class="body" text="" />
            <ui:Label class="caption" text="20 % panel, tilted to latitude, facing the equator, clear sky. M: hide" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
