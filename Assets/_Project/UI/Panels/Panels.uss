.screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.left-column { position: absolute; left: 12px; top: 88px; width: 390px; }
.box { padding: 8px 12px; margin-bottom: 8px; }
.body { font-size: 15px; white-space: normal; padding: 0; margin: 1px 0; }
.numbers { margin-top: 6px; }
.box .caption { white-space: normal; margin-top: 2px; }
.warn { color: var(--critical); }
.bonus { color: rgb(255, 210, 122); }
.totals { margin-left: 2px; }

.slider-label { margin-top: 6px; }
.slider { margin: 2px 0 0 0; }
.slider .unity-base-slider__tracker { background-color: var(--track); border-color: var(--panel-border); }
.slider .unity-base-slider__dragger { background-color: var(--accent); border-color: var(--accent); border-radius: 0; }

.button-row { flex-direction: row; margin-top: 8px; }
.action-button {
    flex-grow: 1;
    margin: 0 4px 0 0;
    padding: 5px 10px;
    font-size: 14px;
    color: var(--text);
    background-color: var(--button);
    border-width: 2px;
    border-color: var(--panel-border);
    border-radius: 0;
}
.action-button:hover { background-color: var(--button-hover); border-color: var(--accent); }
.action-button.primary { color: var(--on-accent); background-color: var(--accent); border-color: var(--accent); -unity-font-style: bold; }
.action-button.primary:hover { background-color: rgb(255, 220, 140); }
.action-button:disabled { opacity: 0.4; }

.bottom-left { position: absolute; left: 12px; bottom: 12px; width: 320px; }
.hint { margin-bottom: 4px; }
.help { font-size: 14px; color: var(--text-muted); margin-bottom: 0; padding: 8px 12px; }

.legend { position: absolute; left: 50%; bottom: 12px; width: 300px; translate: -50% 0; }
.legend .caption { white-space: normal; }
.legend-bar { height: 14px; margin-top: 4px; border-radius: 0; }
.legend-range { flex-direction: row; justify-content: space-between; }

.drag-rect {
    position: absolute;
    border-width: 2px;
    border-color: var(--accent);
    border-radius: 0;
    background-color: rgba(255, 199, 92, 0.18);
}

.build-bar { position: absolute; left: 50%; bottom: 12px; translate: -50% 0; align-items: center; }
.build-row { margin-top: 0; margin-bottom: 4px; }
.build-row .action-button { min-width: 110px; }
.build-tabs { flex-direction: row; justify-content: center; margin-bottom: 4px; }
.build-item { flex-direction: row; align-items: center; margin-right: 4px; }
.build-item .action-button { margin-right: 0; }
.info-button {
    width: 20px; height: 20px; margin: 0 0 0 2px; padding: 0;
    font-size: 12px; -unity-font-style: bold;
    color: var(--accent); background-color: rgba(255, 199, 92, 0.12);
    border-width: 1px; border-color: rgba(255, 199, 92, 0.5); border-radius: 0;
}
.info-button:hover { background-color: rgba(255, 199, 92, 0.3); }
.info-button.selected { color: var(--accent); background-color: rgba(255, 199, 92, 0.16); border-color: var(--accent); }
.build-info { position: absolute; left: 50%; bottom: 130px; translate: -50% 0; width: 540px; }
.build-info-head { flex-direction: row; justify-content: space-between; align-items: center; }
.info-close { width: 22px; height: 22px; margin: 0; padding: 0; background-color: rgba(0, 0, 0, 0); border-width: 0; color: var(--text-muted); font-size: 16px; }
.legend.above-build-bar { bottom: 100px; }
.action-button.mode.selected { color: var(--accent); background-color: rgba(255, 199, 92, 0.16); border-color: var(--accent); -unity-font-style: bold; }

/* Bigger, easier-to-read inspect and info text (director 2026-11-14). */
.box .value { font-size: 19px; }
.box .caption { font-size: 13px; }
.box .heading { font-size: 12px; }
.bottom-left { width: 390px; }

.build-slide { max-width: 640px; }
.build-preview { width: 44px; height: 44px; margin-right: 4px; border-radius: 6px; }
.build-item { padding: 2px 4px; border-radius: 8px; background-color: rgba(255,255,255,0.04); }
